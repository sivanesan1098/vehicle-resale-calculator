# ==============================================================================
# Vehicle Resale Calculator - Environment Configuration Example
# Copy this file to .env and populate your actual keys:
# cp .env.example .env
# ==============================================================================

# Firecrawl Web Scraping API Key
# Docs: https://docs.firecrawl.dev/sdks/cli
# Sign up at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY_HERE

# Google Gemini AI API Key (Used for smart auto-ingestion of unlisted vehicles)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Vehicle Data Provider Optional Key (External Automotive APIs)
VEHICLE_API_KEY=
